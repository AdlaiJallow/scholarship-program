# Copy to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=true
DJANGO_ENVIRONMENT=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

DB_NAME=scholarship_portal
DB_USER=scholarship_portal
DB_PASSWORD=scholarship_portal
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000
MINISTRY_CONTACT_EMAIL=scholarships@example.gov.gm
MINISTRY_CONTACT_PHONE=+220 000 0000

DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_STORAGE_ENDPOINT=http://localhost:9000
DOCUMENT_STORAGE_ACCESS_KEY=
DOCUMENT_STORAGE_SECRET_KEY=
DOCUMENT_STORAGE_BUCKET=scholarship-documents

ANTIVIRUS_SCAN_BACKEND=noop

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.gov.gm

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# locmem is fine for a single-process dev server; set to "redis" in
# staging/production so rate-limit state is shared across workers.
CACHE_BACKEND=locmem
DJANGO_CACHE_URL=redis://localhost:6379/2
